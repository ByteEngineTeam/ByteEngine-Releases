      "Script": "[ENABLE]\n\n{$lua}\nif syntaxcheck == false then\n  -- #region agent log\n  local function agent_log(hid, loc, msg, data)\n    pcall(function()\n      local f = io.open([[debug-f9ebbe.log]], \"a\")\n      if not f then return end\n      local parts = {}\n      if type(data) == \"table\" then\n        for k,v in pairs(data) do parts[#parts+1] = string.format('\"%s\":\"%s\"', tostring(k), tostring(v)) end\n      end\n      f:write(string.format('{\"sessionId\":\"f9ebbe\",\"hypothesisId\":\"%s\",\"location\":\"%s\",\"message\":\"%s\",\"data\":{%s},\"timestamp\":%d}\\n',\n        hid, loc, msg, table.concat(parts, \",\"), (getTickCount and getTickCount()) or 0))\n      f:close()\n    end)\n  end\n  -- #endregion\n  local before = (getAddressSafe and getAddressSafe(\"inputPumpWorker\")) or 0\n  agent_log(\"C\", \"InputPump.ENABLE.lua\", \"pre_enable\", {before=string.format(\"%X\", tonumber(before) or 0)})\n  -- Drop stale UserSymbols from earlier broken Lua alloc (0x800000)\n  if before ~= 0 and before < 0x1000000 then\n    pcall(deAlloc, before)\n  end\n  pcall(unregisterSymbol, \"inputPumpWorker\")\n  pcall(unregisterSymbol, \"inputPumpHalt\")\n  pcall(unregisterSymbol, \"ctxPtr\")\n  pcall(unregisterSymbol, \"harvestTick\")\n  pcall(unregisterSymbol, \"forceHarvest\")\nend\n{$asm}\n\nalloc( inputPumpWorker, 8192, ACS.exe )\nregistersymbol( inputPumpWorker )\n\ndefine( inputPumpHalt, inputPumpWorker+800 )\ndefine( stashMoney, inputPumpWorker+810 )\ndefine( pstashVoltaic, inputPumpWorker+818 )\ndefine( pstashSmoke, inputPumpWorker+820 )\ndefine( pstashKnives, inputPumpWorker+828 )\ndefine( stashMeds, inputPumpWorker+830 )\ndefine( pstashDarts, inputPumpWorker+838 )\ndefine( stashRounds, inputPumpWorker+840 )\ndefine( pstashFear, inputPumpWorker+848 )\ndefine( stashSpikes, inputPumpWorker+850 )\ndefine( stashLeather, inputPumpWorker+858 )\ndefine( stashIron, inputPumpWorker+860 )\ndefine( stashThread, inputPumpWorker+868 )\ndefine( stashChem, inputPumpW