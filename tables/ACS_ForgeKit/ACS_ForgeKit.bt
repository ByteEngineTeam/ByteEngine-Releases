    {
      "Description": "[3] Inventory Desk (BeWT / item+0x28)",
      "Kind": "Script",
      "Type": "Auto Assembler Script",
      "Script": "[ENABLE]\n{$lua}\nif syntaxcheck then return end\n-- Tear down any previous desk so we never keep a stale Lua form.\nif ACS_ForgeInv and ACS_ForgeInv.form then\n  pcall(function() if not ACS_ForgeInv.form.Destroyed then ACS_ForgeInv.form.destroy() end end)\nend\nACS_ForgeInv, ACS_Inv = nil, nil\nlocal function resolveGui(name)\n  local candidates = {\n    [[tables\\ACS_ForgeKit\\]] .. name,\n    [[tables\\ACS_ForgeKit\\]] .. name,\n  }\n  local base = (getCheatEngineDir and getCheatEngineDir()) or \"\"\n  if base ~= \"\" then\n    if not base:find(\"[\\\\/]$\") then base = base .. \"\\\\\" end\n    candidates[#candidates+1] = base .. \"tables\\\\ACS_ForgeKit\\\\\" .. name\n  end\n  for _,p in ipairs(candidates) do\n    local f = io.open(p, \"r\")\n    if f then f:close() return p end\n  end\n  return candidates[1]\nend\nlocal path = resolveGui(\"inventory_editor.lua\")\nprint(\"[ACS ForgeKit] Inventory Desk from \" .. tostring(path))\nlocal f = io.open(path, \"r\")\nif not f then\n  error(\"Missing inventory GUI: \"..path)\nend\nlocal src = f:read(\"*a\")\nf:close()\nassert(load(src))()\n{$asm}\n\n[DISABLE]\n{$lua}\nif ACS_ForgeInv and ACS_ForgeInv.form then\n  pcall(function() if not ACS_ForgeInv.form.Destroyed then ACS_ForgeInv.form.destroy() end end)\nend\nACS_ForgeInv, ACS_Inv = nil, nil\n{$asm}\n",
      "Indent": 1
    },
    {
      "Description": "[4] Gear Desk (weapons / armor / outfits)",
      "Kind": "Script",
      "Type": "Auto Assembler Script",
      "Script": "[ENABLE]\n{$lua}\nif syntaxcheck then return end\nif ACS_ForgeGear and ACS_ForgeGear.form then\n  pcall(function() if not ACS_ForgeGear.form.Destroyed then ACS_ForgeGear.form.destroy() end end)\nend\nACS_ForgeGear = nil\nlocal function resolveGui(name)\n  local candidates = {\n    [[tables\\ACS_ForgeKit\\]] .. name,\n    [[tables\\ACS_ForgeKit\\]] .. name,\n  }\n  local base = (getCheatEngineDir and getCheatEngineDir()) or \"\"\n  if base ~= \"\" then\n    if not base:find(\"[\\\\/]$\") then base = base .. \"\\\\\" end\n    candidates[#candidates+1] = base .. \"tables\\\\ACS_ForgeKit\\\\\" .. name\n  end\n  for _,p in ipairs(candidates) do\n    local f = io.open(p, \"r\")\n    if f then f:close() return p end\n  end\n  return candidates[1]\nend\nlocal path = resolveGui(\"gear_editor.lua\")\nprint(\"[ACS ForgeKit] Gear Desk from \" .. tostring(path))\nlocal f = io.open(path, \"r\")\nif not f then\n  error(\"Missing gear GUI: \"..path)\nend\nlocal src = f:read(\"*a\")\nf:close()\nassert(load(src))()\n{$asm}\n\n[DISABLE]\n{$lua}\nif ACS_ForgeGear and ACS_ForgeGear.form then\n  pcall(function() if not ACS_ForgeGear.form.Destroyed then ACS_ForgeGear.form.destroy() end end)\nend\nACS_ForgeGear = nil\n{$asm}\n",
      "Indent": 1
    },
    {
      "Description": "[5] Progress Desk (XP / upgrades / gang / perks)",
      "Kind": "Script",
      "Type": "Auto Assembler Script",
      "Script": "[ENABLE]\n{$lua}\nif syntaxcheck then return end\nif ACS_ForgeProgress and ACS_ForgeProgress.form then\n  pcall(function() if not ACS_ForgeProgress.form.Destroyed then ACS_ForgeProgress.form.destroy() end end)\nend\nACS_ForgeProgress = nil\nlocal function resolveGui(name)\n  local candidates = {\n    [[tables\\ACS_ForgeKit\\]] .. name,\n    [[tables\\ACS_ForgeKit\\]] .. name,\n  }\n  local base = (getCheatEngineDir and getCheatEngineDir()) or \"\"\n  if base ~= \"\" then\n    if not base:find(\"[\\\\/]$\") then base = base .. \"\\\\\" end\n    candidates[#candidates+1] = base .. \"tables\\\\ACS_ForgeKit\\\\\" .. name\n  end\n  for _,p in ipairs(candidates) do\n    local f = io.open(p, \"r\")\n    if f then f:close() return p end\n  end\n  return candidates[1]\nend\nlocal path = resolveGui(\"progress_editor.lua\")\nprint(\"[ACS ForgeKit] Progress Desk from \" .. tostring(path))\nlocal f = io.open(path, \"r\")\nif not f then\n  error(\"Missing progress GUI: \"..path)\nend\nlocal src = f:read(\"*a\")\nf:close()\nassert(load(src))()\n{$asm}\n\n[DISABLE]\n{$lua}\nif ACS_ForgeProgress and ACS_ForgeProgress.form then\n  pcall(function() if not ACS_ForgeProgress.form.Destroyed then ACS_ForgeProgress.form.destroy() end end)\nend\nACS_ForgeProgress = nil\n{$asm}\n",
      "Indent": 1
    },
